# Copiar a .env en local. En Vercel y en GitHub (secretos del repo) se
# configuran las mismas variables. Nunca se commitea el .env real.

# Ticket de la API de Mercado Público (https://www.chilecompra.cl/api/).
# Límite: 10.000 consultas diarias. Solo lo usa el servidor.
MP_API_TICKET=

# Postgres (Supabase). En Vercel, el pooler en modo transacción (puerto 6543);
# en GitHub Actions (ingesta), la conexión directa o el pooler en modo sesión.
# Sin esta variable el sitio funciona solo con búsqueda por código.
DATABASE_URL=

# Opcionales de la ingesta (npm run ingesta).
# INGESTA_PRESUPUESTO=300
# INGESTA_LIMITE_DIARIO=8000
